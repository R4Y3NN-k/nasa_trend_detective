# Copy to .env (gitignored) and fill in. Never commit real values.
# Earthdata Login (https://urs.earthdata.nasa.gov/): Giovanni (step 7) and AppEEARS (step 8).
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Optional instead of username/password: an Earthdata bearer token.
EARTHDATA_TOKEN=
# Google Gemini (free key: https://aistudio.google.com/apikey): plain-language summary + suggested questions.
# Without it the app writes the summary from a template.
GEMINI_API_KEY=
# Optional: override the model, e.g. a newer Flash model.
# GEMINI_MODEL=gemini-2.5-flash
